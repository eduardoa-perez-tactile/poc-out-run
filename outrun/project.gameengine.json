{
  "$schemaVersion": 2,
  "name": "OutRun",
  "bundleId": {
    "ios": "com.example.outrun",
    "android": "com.example.outrun"
  },
  "version": "0.1.0",
  "sim": {
    "dt": 0.016666667,
    "maxStepsPerFrame": 5,
    "physicsThreads": 1,
    "hashInDev": true,
    "seed": 1
  },
  "js": {
    "entry": "src/main.ts",
    "target": "es2020"
  },
  "render": {
    "defaultTier": "auto",
    "tiers": {
      "mobile": {
        "msaa": 1,
        "hdr": false
      },
      "compat": {
        "msaa": 1,
        "hdr": false
      }
    },
    "clearColor": [
      0.1,
      0.13,
      0.22,
      1
    ],
    "sortingLayers": [
      "Default"
    ],
    "pixelsPerUnit": 100
  },
  "ui": {
    "referenceResolution": [
      1920,
      1080
    ],
    "orientation": "landscape"
  },
  "text": {
    "defaultFont": "fonts/NotoSans-Regular"
  },
  "bundles": [
    {
      "name": "base",
      "include": [
        "**"
      ],
      "delivery": "in-app",
      "exclude": [
        "assets/art/vehicles/player/**",
        "assets/art/vehicles/effects/**",
        "assets/art/environments/map01/**"
      ]
    }
  ],
  "targets": [
    "ios",
    "android"
  ],
  "platforms": [
    "mobile",
    "web"
  ],
  "assets": {
    "groups": {
      "player-ferrari1": {
        "include": [
          "assets/textures/player-ferrari1.png",
          "assets/materials/player-car.material.ts"
        ]
      },
      "map01-environment": {
        "include": [
          "assets/textures/map01-*.png",
          "assets/materials/map01-*.material.ts",
          "assets/materials/map01-*-draw.mat.json"
        ]
      },
      "traffic-source": {
        "include": [
          "assets/textures/traffic-source.png",
          "assets/materials/traffic-composite.material.ts",
          "assets/materials/traffic-composite-draw.mat.json"
        ]
      },
      "traffic-catalog": {
        "include": [
          "assets/textures/traffic-catalog-reference.png",
          "assets/materials/traffic-catalog-draw.mat.json"
        ]
      },
      "biome-map01-data": {
        "include": [
          "assets/data/biomes/map01.json"
        ]
      },
      "biome-map02-data": {
        "include": [
          "assets/data/biomes/map02.json"
        ]
      },
      "biome-map03-data": {
        "include": [
          "assets/data/biomes/map03.json"
        ]
      },
      "biome-map04-data": {
        "include": [
          "assets/data/biomes/map04.json"
        ]
      },
      "biome-map05-data": {
        "include": [
          "assets/data/biomes/map05.json"
        ]
      },
      "biome-map06-data": {
        "include": [
          "assets/data/biomes/map06.json"
        ]
      },
      "biome-map07-data": {
        "include": [
          "assets/data/biomes/map07.json"
        ]
      },
      "biome-map08-data": {
        "include": [
          "assets/data/biomes/map08.json"
        ]
      },
      "biome-map09-data": {
        "include": [
          "assets/data/biomes/map09.json"
        ]
      },
      "biome-map10-data": {
        "include": [
          "assets/data/biomes/map10.json"
        ]
      },
      "biome-map11-data": {
        "include": [
          "assets/data/biomes/map11.json"
        ]
      },
      "biome-map12-data": {
        "include": [
          "assets/data/biomes/map12.json"
        ]
      },
      "biome-map13-data": {
        "include": [
          "assets/data/biomes/map13.json"
        ]
      },
      "biome-map14-data": {
        "include": [
          "assets/data/biomes/map14.json"
        ]
      },
      "biome-map15-data": {
        "include": [
          "assets/data/biomes/map15.json"
        ]
      },
      "biome-goal-data": {
        "include": [
          "assets/data/biomes/goal.json"
        ]
      },
      "biome-catalog-data": {
        "include": [
          "assets/data/biome-catalog.json"
        ]
      }
    }
  },
  "startScene": "scenes/road-proof.scene.json",
  "check": {
    "smoke": {
      "frames": 120
    }
  }
}
