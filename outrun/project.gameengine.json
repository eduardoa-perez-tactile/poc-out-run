{
  "$schemaVersion": 2,
  "name": "OutRun",
  "bundleId": { "ios": "com.example.outrun", "android": "com.example.outrun" },
  "version": "0.1.0",
  "sim": { "dt": 0.016666667, "maxStepsPerFrame": 5, "physicsThreads": 1, "hashInDev": true, "seed": 1 },
  "js": { "entry": "src/main.ts", "target": "es2020" },
  "render": {
    "defaultTier": "auto",
    "tiers": { "mobile": { "msaa": 1, "hdr": false }, "compat": { "msaa": 1, "hdr": false } },
    "clearColor": [0.1, 0.13, 0.22, 1],
    "sortingLayers": ["Default"],
    "pixelsPerUnit": 100
  },
  "ui": { "referenceResolution": [1080, 1920], "orientation": "portrait" },
  "text": { "defaultFont": "fonts/NotoSans-Regular" },
  "bundles": [{ "name": "base", "include": ["**"], "delivery": "in-app" }],
  "targets": ["ios", "android"],
  "platforms": ["mobile", "web"],
  "startScene": "scenes/main.scene.json"
}
